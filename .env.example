# ============================================================================
# NYSI INSMS — Root Environment Variables
# Copy this file to .env and fill in your values.
# docker-compose.yml reads from this file automatically.
# ============================================================================

# ── Database (PostgreSQL / AWS RDS) ─────────────────────────────────────────
PGHOST=your-db-host.rds.amazonaws.com
PGPORT=5433
PGDATABASE=your_db_name
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGSSLMODE=require
# Set PGSSLMODE=disable if using the local containerised Postgres (no SSL)

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h

# ── 2FA Email (Gmail app password) ───────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
SKIP_2FA=false
CODE_EXPIRY_MINUTES=10
MAX_VERIFICATION_ATTEMPTS=3

# ── OpenAI (used by Python Services for OCR parsing + web scraping) ──────────
OPENAI_API_KEY=sk-proj-...

# ── ML / Vectorisation ───────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384
